{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " ➜ "
  },
  "modules": [
    "title",
    "separator",
    
    // System Info
    {
      "type": "os",
      "key": "OS",
      "keyColor": "34" // Blue
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "34"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "34"
    },
    {
      "type": "packages",
      "key": "Pkgs",
      "keyColor": "34"
    },
    "break",

    // Desktop Environment
    {
      "type": "de",
      "key": "DE",
      "keyColor": "36" // Cyan
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "36"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "36"
    },
    {
      "type": "terminal",
      "key": "Term",
      "keyColor": "36"
    },
    "break",

    // Hardware
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "32", // Green
      "temp": true
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "32",
      "temp": true,
      "hideType": "integrated"
    },
    {
      "type": "memory",
      "key": "RAM",
      "keyColor": "32"
    },
    {
      "type": "disk",
      "key": "Disk",
      "keyColor": "32"
    },
    "break",
    
    "colors"
  ]
}
